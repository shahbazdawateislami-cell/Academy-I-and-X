rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidStudent(data) {
      return data.keys().hasAll(['id', 'name', 'fatherName', 'mobile', 'totalFee', 'paidFee', 'remainingFee', 'admissionDate'])
        && data.keys().hasOnly(['id', 'name', 'fatherName', 'mobile', 'totalFee', 'paidFee', 'remainingFee', 'admissionDate', 'notes', 'monthlyFee', 'lastFeeAddedMonth', 'status'])
        && data.id is string && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.fatherName is string && data.fatherName.size() > 0 && data.fatherName.size() <= 100
        && data.mobile is string && data.mobile.matches('^[0-9]{10,15}$')
        && data.totalFee is number
        && data.paidFee is number
        && data.remainingFee is number
        && data.admissionDate is string
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000))
        && (!('monthlyFee' in data) || data.monthlyFee is number)
        && (!('lastFeeAddedMonth' in data) || (data.lastFeeAddedMonth is string && data.lastFeeAddedMonth.matches('^[0-9]{4}-[0-9]{2}$')))
        && (!('status' in data) || (data.status in ['active', 'inactive']));
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['id', 'type', 'category', 'amount', 'date', 'paymentMode'])
        && data.keys().hasOnly(['id', 'type', 'category', 'amount', 'date', 'description', 'paymentMode', 'studentId', 'month', 'receiptNo', 'previouslyPaid', 'totalPaidAfter', 'remainingBalanceAfter', 'paidTo', 'donorName', 'donorMobile', 'donorAddress'])
        && data.id is string && data.id.matches('^[a-zA-Z0-9_\\-]+$')
        && data.type in ['INCOME', 'EXPENSE', 'FEE']
        && data.category is string && data.category.size() > 0 && data.category.size() <= 100
        && data.amount is number && data.amount >= 0
        && data.date is string
        && data.paymentMode is string && data.paymentMode.size() > 0 && data.paymentMode.size() <= 50
        && (!('description' in data) || (data.description is string && data.description.size() <= 1000))
        && (!('studentId' in data) || (data.studentId is string && data.studentId.matches('^[a-zA-Z0-9_\\-]+$')))
        && (!('month' in data) || (data.month is string && data.month.size() <= 50))
        && (!('receiptNo' in data) || (data.receiptNo is string && data.receiptNo.size() <= 50))
        && (!('previouslyPaid' in data) || data.previouslyPaid is number)
        && (!('totalPaidAfter' in data) || data.totalPaidAfter is number)
        && (!('remainingBalanceAfter' in data) || data.remainingBalanceAfter is number)
        && (!('paidTo' in data) || (data.paidTo is string && data.paidTo.size() <= 100))
        && (!('donorName' in data) || (data.donorName is string && data.donorName.size() <= 100))
        && (!('donorMobile' in data) || (data.donorMobile is string && data.donorMobile.size() <= 20))
        && (!('donorAddress' in data) || (data.donorAddress is string && data.donorAddress.size() <= 200));
    }

    // --- Collection Matches ---

    match /students/{studentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(studentId) && isValidStudent(incoming());
      allow update: if isSignedIn() && isValidStudent(incoming());
      allow delete: if isSignedIn();
    }

    match /transactions/{transactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(transactionId) && isValidTransaction(incoming());
      allow update: if isSignedIn() && isValidTransaction(incoming());
      allow delete: if isSignedIn();
    }
  }
}
