{
  "entities": {
    "student": {
      "title": "Student",
      "description": "A student registered in the academy",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "fatherName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "mobile": { "type": "string", "pattern": "^[0-9]{10,15}$" },
        "totalFee": { "type": "number" },
        "paidFee": { "type": "number" },
        "remainingFee": { "type": "number" },
        "admissionDate": { "type": "string", "format": "date" },
        "notes": { "type": "string", "maxLength": 1000 },
        "monthlyFee": { "type": "number" },
        "lastFeeAddedMonth": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["id", "name", "fatherName", "mobile", "totalFee", "paidFee", "remainingFee", "admissionDate"]
    },
    "transaction": {
      "title": "Transaction",
      "description": "An income, expense, or fee payment transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "type": { "type": "string", "enum": ["INCOME", "EXPENSE", "FEE"] },
        "category": { "type": "string", "minLength": 1, "maxLength": 100 },
        "amount": { "type": "number", "minimum": 0 },
        "date": { "type": "string", "format": "date-time" },
        "description": { "type": "string", "maxLength": 1000 },
        "paymentMode": { "type": "string", "minLength": 1, "maxLength": 50 },
        "studentId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "month": { "type": "string", "maxLength": 50 },
        "receiptNo": { "type": "string", "maxLength": 50 },
        "previouslyPaid": { "type": "number" },
        "totalPaidAfter": { "type": "number" },
        "remainingBalanceAfter": { "type": "number" },
        "paidTo": { "type": "string", "maxLength": 100 },
        "donorName": { "type": "string", "maxLength": 100 },
        "donorMobile": { "type": "string", "maxLength": 20 },
        "donorAddress": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "type", "category", "amount", "date", "paymentMode"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "student",
      "description": "Collection of students"
    },
    "/transactions/{transactionId}": {
      "schema": "transaction",
      "description": "Collection of all financial transactions"
    }
  }
}
